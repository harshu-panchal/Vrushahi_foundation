# MongoDB connection string (MongoDB Atlas free tier recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vrushahi_foundation

# Admin login
ADMIN_EMAIL=admin@vrushahifoundation.org
# Generate with: node scripts/hash-password.js "your-chosen-password"
ADMIN_PASSWORD_HASH=

# Random 32+ byte secret used to sign admin session tokens.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Razorpay (Dashboard → Settings → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → add https://<your-domain>/api/webhooks/razorpay
# for payment.captured and payment.failed, then paste its secret here.
RAZORPAY_WEBHOOK_SECRET=

# SMTP — used to email donors a copy of their donation receipt.
# Leave blank to disable email sending (donation still records normally).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vrushahi Foundation <donations@vrushahifoundation.org>"
