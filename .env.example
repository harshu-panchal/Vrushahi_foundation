# MongoDB connection string (MongoDB Atlas free tier recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vrushahi_foundation

# Admin login
ADMIN_EMAIL=admin@vrushahifoundation.org
# Generate with: node scripts/hash-password.js "your-chosen-password"
ADMIN_PASSWORD_HASH=

# Random 32+ byte secret used to sign admin session tokens.
# Generate with: openssl rand -base64 32
SESSION_SECRET=
